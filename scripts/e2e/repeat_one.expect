#!/usr/bin/env expect -f
# repeat_one.expect — drive a real metis chat session via PTY and
# verify that pressing "1" five times leaves "11111" in the input box.
#
# Reproduces the user video 2026-05-07 21:18 bug ("typing 1 five times
# oscillated between 1 and 11"). Used as both manual smoke and the
# starting point of an e2e harness.
#
# Usage:
#   ./scripts/e2e/repeat_one.expect [path-to-metis]
# Defaults to metis on PATH.

set metis [lindex $argv 0]
if {$metis eq ""} { set metis "metis" }

# Stale metis processes from a previous run hold onto session-state
# locks and slow the next launch enough to blow the 25s expect timeout.
# Clean them up before spawning. Best-effort: ignore "no such process".
catch {exec pkill -9 -f "metis chat"}
after 200

# Sized PTY so metis's two-phase render computes a non-collapsing
# viewport. Without explicit rows/cols spawn defaults to 24x80 and
# the chat list occasionally floors itself.
set stty_init "rows 30 cols 120"

spawn $metis chat
set timeout 60

# Cold-start cushion. metis loads ~600ms on warm cache but can hit
# 4-5s after a cold boot (config + tool registry + LLM probe + first
# View()). Pure `after` is more reliable than `expect "auto mode"`
# under expect's PTY which intermittently drops the matchable text
# bytes when the redraw stream is bursty. 5s is generous.
after 5000

# Send five "1"s — slowly, so the redraw of one digit completes
# before the next is queued. expect can't reliably match against
# arbitrary substrings of the alt-screen redraw stream (cursor save
# / restore makes the digits land at varying byte offsets), so we
# pace the input rather than block on echo.
for {set i 0} {$i < 5} {incr i} {
    send -- "1"
    after 250
}

# Wait for the final redraw to settle.
after 1500

# Quit metis cleanly (Ctrl+C single-press: when no turn is active
# metis exits immediately — handled in keybind_main.go).
send -- "\x03"
after 300

# Drain whatever's left so $expect_out(buffer) holds the full session.
expect {
    eof { }
    timeout { }
}

# Get the captured raw bytes. With the OSC-leak bug, the textarea
# would oscillate between "1" and "11" as scrubEscapeLeaks ate every
# third digit. The fixed code grows monotonically, so the alt-screen
# redraw stream will at some point contain "11111" — the textarea's
# View() interleaves SGR with the rune sequence but the digits stay
# adjacent.
#
# scan() strips ANSI escapes so plain "11111" is found even if the
# raw stream had `\x1b[1m1\x1b[0m...` style runs.
proc strip_ansi {s} {
    regsub -all {\x1b\[[0-9;?]*[a-zA-Z]} $s "" s
    regsub -all {\x1b\][^\x07]*\x07} $s "" s
    return $s
}

set plain [strip_ansi $expect_out(buffer)]
if {[regexp {11111} $plain]} {
    puts "PASS: input grew to 11111 across five keypresses"
    exit 0
} else {
    puts "FAIL: input never reached 11111."
    puts "Stripped buffer tail ~"
    puts [string range $plain end-300 end]
    exit 1
}
